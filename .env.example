# Suku Restaurant - Environment Configuration Template
# Duplicate this file as .env and fill in values for production/local use.
# NEVER commit the real .env file.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Owner Credentials (seeded into database on initial setup)
ADMIN_EMAIL=owner@sukuhsr.com
