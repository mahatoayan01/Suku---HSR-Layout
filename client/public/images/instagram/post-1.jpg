<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#291414" />
      <stop offset="100%" stop-color="#140909" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-opacity="0.03" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#grad)" />
  <rect width="800" height="600" fill="url(#grid)" />
  
  <circle cx="400" cy="240" r="110" fill="#C8362B" fill-opacity="0.12" stroke="#C8362B" stroke-opacity="0.3" stroke-width="2"/>
  
  <text x="400" y="260" font-family="'Inter', sans-serif" font-size="72" text-anchor="middle" fill="#FFFFFF" opacity="0.9">📸</text>
  
  <text x="400" y="390" font-family="'Cormorant Garamond', Georgia, serif" font-size="34" font-weight="600" text-anchor="middle" fill="#F7F3EC" letter-spacing="1">Sushi Reel Spotlight</text>
  
  <text x="400" y="425" font-family="'Inter', sans-serif" font-size="15" text-anchor="middle" fill="#B8923A" letter-spacing="2" text-transform="uppercase">@sukuhsr • Dynamite Maki Roll</text>
  
  <rect x="360" y="450" width="80" height="2" fill="#C8362B" opacity="0.6" />
  <text x="400" y="480" font-family="'Inter', sans-serif" font-size="12" text-anchor="middle" fill="#8E8E93">SUKU • HSR LAYOUT</text>
</svg>